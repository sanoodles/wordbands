{
  "name": "wordbands",
  "version": "0.0.0",
  "private": true,
  "description": "wordbands — a vocabulary learning tool: every English word placed on a frequency and CEFR learning band.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "skills:sync": "node scripts/sync-next-skills.mjs && npx -y skills@latest update -y",
    "skills:check": "node scripts/check-fondue-install.mjs && node scripts/sync-next-skills.mjs --check",
    "spec:check": "node scripts/check-spec.mjs",
    "spec:list": "node scripts/check-spec.mjs --list",
    "spec:files": "node scripts/check-spec.mjs --file",
    "ignores:check": "node scripts/check-dependabot-ignores.mjs",
    "versions:check": "node scripts/check-versions.mjs",
    "decode:check": "node scripts/check-deployed-decodes.mjs",
    "a11y:check": "node scripts/check-a11y-transcript.mjs",
    "load:check": "node scripts/check-load.mjs",
    "a11y:update": "node scripts/check-a11y-transcript.mjs --update",
    "probe": "node scripts/probe.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "^5.9.2"
  }
}
